  <!-- ================================================== -->
  <!-- 🛍️ PANIER -->
  <!-- ================================================== -->

  <% total = 0.to_d %>

  <% if session[:ventes].present? %>

    <table class="table-auto w-full mb-6 border">

      <thead>
        <tr class="bg-gray-100 text-sm text-gray-700 uppercase">

          <th class="px-3 py-2 text-left">
            Produit
          </th>

          <th class="px-2 py-2 text-center">
            Taille
          </th>

          <th class="px-2 py-2 text-center">
            Qté
          </th>

          <th class="px-2 py-2 text-center">
            Prix
          </th>

          <th class="px-2 py-2 text-center">
            Remise
          </th>

          <th class="px-2 py-2 text-center">
            Total
          </th>

          <th class="px-2 py-2 text-center">
            Stock
          </th>

          <th class="px-2 py-2 text-center">
            Actions
          </th>

        </tr>
      </thead>


      <tbody>

        <% session[:ventes].each do |panier_id, valeur_originale| %>

          <!--
            Compatibilité ancien format session :
            produit_id => quantité entière

            Nouveau format :
            panier_id => {
              produit_id,
              produit_taille_id,
              taille,
              quantite,
              prix,
              remise
            }
          -->

          <% valeur =
               if valeur_originale.is_a?(Hash)
                 valeur_originale
               else
                 {
                   "quantite" => valeur_originale.to_i
                 }
               end %>


          <!-- Détermination du produit -->
          <% produit_id =
               if valeur["produit_id"].present?
                 valeur["produit_id"]
               elsif panier_id.to_s.match?(/\A\d+\z/)
                 panier_id.to_i
               end %>

          <% produit = Produit.find_by(id: produit_id) %>

          <% next unless produit %>


          <!-- Détermination éventuelle de la taille chaussure -->
          <% produit_taille =
               if valeur["produit_taille_id"].present?
                 ProduitTaille.find_by(
                   id: valeur["produit_taille_id"]
                 )
               end %>


          <% quantite =
               [valeur["quantite"].to_i, 1].max %>


          <% remise =
               valeur["remise"].present? ?
                 valeur["remise"].to_d :
                 0.to_d %>


          <!-- Prix réellement enregistré dans le panier -->
          <% prix_unitaire =
               if valeur["prix"].present?

                 valeur["prix"].to_d

               elsif produit.en_promo? &&
                     produit.prix_promo.present?

                 produit.prix_promo.to_d

               else

                 produit.prix.to_d

               end %>


          <% total_produit =
               (
                 prix_unitaire *
                 quantite *
                 (1 - remise / 100)
               ).round(2) %>


          <% total += total_produit %>


          <tr class="border-t">

            <!-- ======================================== -->
            <!-- PRODUIT -->
            <!-- ======================================== -->

            <td class="px-3 py-2">

              <span class="font-medium">
                <%= produit.nom %>
              </span>

              <% if produit_taille.present? %>
                <div class="text-xs text-gray-500">
                  Code :
                  <%= produit_taille.code_barre %>
                </div>
              <% end %>

            </td>


            <!-- ======================================== -->
            <!-- TAILLE -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center">

              <% if produit_taille.present? %>

                <span
                  class="
                    inline-block
                    px-2
                    py-1
                    rounded
                    bg-blue-100
                    text-blue-800
                    font-semibold
                  "
                >
                  <%= produit_taille.taille %>
                </span>

              <% elsif produit.taille.present? %>

                <%= produit.taille %>

              <% else %>

                —

              <% end %>

            </td>


            <!-- ======================================== -->
            <!-- QUANTITÉ -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center">
              <%= quantite %>
            </td>


            <!-- ======================================== -->
            <!-- PRIX -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center whitespace-nowrap">

              <% if produit.en_promo? &&
                    produit.prix_promo.present? %>

                <span
                  class="
                    relative
                    inline-block
                    text-base
                    text-gray-600
                    font-medium
                  "
                >

                  <span class="inline-block">
                    <%= number_to_currency(produit.prix) %>
                  </span>

                  <span
                    style="
                      position: absolute;
                      top: 50%;
                      left: 0;
                      width: 100%;
                      height: 2px;
                      background-color: red;
                      transform: rotate(-15deg);
                      transform-origin: left center;
                    "
                  ></span>

                </span>

                <span class="ml-1 text-red-600 font-bold">
                  <%= number_to_currency(prix_unitaire) %>
                </span>

              <% else %>

                <%= number_to_currency(prix_unitaire) %>

              <% end %>

            </td>


            <!-- ======================================== -->
            <!-- REMISE -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center">

              <%= form_with url: caisse.modifier_remise_ventes_path,
                    method: :post,
                    local: true do %>

                <!-- IMPORTANT :
                     on transmet la clé exacte du panier
                     ex : "923" ou "taille_5"
                -->
                <%= hidden_field_tag :produit_id,
                      panier_id %>

                <%= select_tag :remise,
                      options_for_select(
                        (0..70).step(10).map { |v|
                          ["#{v} %", v]
                        },
                        selected: remise.to_i
                      ),
                      class: "w-20 border rounded text-right",
                      onchange: "this.form.submit();" %>

              <% end %>

            </td>


            <!-- ======================================== -->
            <!-- TOTAL LIGNE -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center font-semibold text-green-700">

              <%= number_to_currency(total_produit) %>

            </td>


            <!-- ======================================== -->
            <!-- STOCK -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center text-sm text-gray-500">

              <% if produit_taille.present? %>

                <span
                  class="
                    inline-block
                    px-2
                    py-1
                    rounded
                    bg-gray-100
                    text-gray-600
                    whitespace-nowrap
                  "
                >
                  T.<%= produit_taille.taille %> :
                  <strong><%= produit_taille.stock %></strong>
                </span>

              <% else %>

                <span
                  class="
                    inline-block
                    px-2
                    py-1
                    rounded
                    bg-gray-100
                    text-gray-600
                    whitespace-nowrap
                  "
                >
                  Stock :
                  <strong><%= produit.stock %></strong>
                </span>

              <% end %>

            </td>


            <!-- ======================================== -->
            <!-- RETIRER -->
            <!-- ======================================== -->

            <td class="px-2 py-2 text-center">

              <%= button_to "Retirer",
                    retirer_produit_ventes_path(
                      produit_id: panier_id
                    ),
                    method: :post,
                    class: "text-red-600 hover:underline" %>

            </td>

          </tr>

        <% end %>


        <!-- ============================================ -->
        <!-- TOTAL GÉNÉRAL -->
        <!-- ============================================ -->

        <tr class="border-t font-semibold">

          <td
            colspan="5"
            class="px-4 py-2 text-right"
          >
            Total :
          </td>

          <td
            colspan="3"
            class="px-4 py-2 text-right"
          >

            <span
              id="total-general"
              data-total="<%= total.to_f %>"
            >
              <%= number_to_currency(total) %>
            </span>

          </td>

        </tr>

      </tbody>

    </table>

  <% end %>
