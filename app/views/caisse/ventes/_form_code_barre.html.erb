<%= turbo_frame_tag "form_code_barre" do %>
  <%= form_with url: recherche_produit_ventes_path,
        method: :post,
        data: { turbo_frame: "form_code_barre" } do |f| %>

    <div class="mb-4">
      <%= f.label :code_barre,
            "Code-barres",
            class: "block font-medium" %>

      <div class="flex gap-2">
        <%= f.text_field :code_barre,
              autofocus: true,
              autocomplete: "off",
              class: "mt-1 block flex-1 rounded border-gray-300 shadow-sm",
              placeholder: "Tapez le code-barres puis Entrée" %>

        <%= f.submit "Ajouter",
              class: "mt-1 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" %>
      </div>
    </div>

  <% end %>
<% end %>